<odoo>

    <record id="view_interview_kandidat_list" model="ir.ui.view">
        <field name="name">interview.kandidat.list</field>
        <field name="model">interview.kandidat</field>
        <field name="arch" type="xml">
            <list string="Penilaian Interview Kandidat">
                <field name="kandidat_name"/>
                <field name="posisi_dilamar"/>
                <field name="interviewer_id"/>
                <field name="waktu_interview"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_interview_kandidat_form" model="ir.ui.view">
        <field name="name">interview.kandidat.form</field>
        <field name="model">interview.kandidat</field>
        <field name="arch" type="xml">
            <form string="Penilaian Interview Kandidat">
                <sheet>
                    <group>
                        <group>
                            <field name="kandidat_name"/>
                            <field name="posisi_dilamar"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="interviewer_id"/>
                            <field name="waktu_interview"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Kriteria Penilaian">
                            <field name="data_ids">
                                <list editable="bottom">
                                    <field name="kriteria"/>
                                    <field name="skor"/>
                                    <field name="catatan"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_interview_kandidat_search" model="ir.ui.view">
        <field name="name">interview.kandidat.search</field>
        <field name="model">interview.kandidat</field>
        <field name="arch" type="xml">
            <search string="Cari Penilaian Interview">
                <field name="kandidat_name"/>
                <field name="posisi_dilamar"/>
                <field name="interviewer_id"/>
                
                <filter string="Draft" name="filter_draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Lolos" name="filter_passed" domain="[('status', '=', 'passed')]"/>
                <filter string="Ditolak" name="filter_rejected" domain="[('status', '=', 'rejected')]"/>

                <filter string="Status" name="group_state" context="{'group_by': 'status'}"/>
                <filter string="Interviewer" name="group_interviewer" context="{'group_by': 'interviewer_id'}"/>

            </search>
        </field>
    </record>

    <record id="action_interview_kandidat" model="ir.actions.act_window">
        <field name="name">Penilaian Interview Kandidat</field>
        <field name="res_model">interview.kandidat</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>